              "raw": "{\n  \"customer\": \"سارة المقطري\",\n  \"items\": [\n    {\n      \"name\": \"دقيق 10 كيلو\",\n      \"qty\": -2,\n      \"price\": 9500\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/invoices",
