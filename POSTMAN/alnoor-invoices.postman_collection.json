    {
      "name": "2. Ignore Client Totals (201)",
      "item": [
        {
          "name": "Ignore Client Total - خالد العولقي",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Server ignores client-supplied totals and recalculates', function () {",
                  "    pm.expect(json.total).to.not.equal(1);",
                  "    pm.expect(json.subtotal).to.equal(9800);",
                  "    pm.expect(json.tax).to.equal(1470);",
                  "    pm.expect(json.total).to.equal(11270);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "inv-khaled-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": \"خالد العولقي\",\n  \"total\": 1,\n  \"subtotal\": 1,\n  \"tax\": 0,\n  \"items\": [\n    {\n      \"name\": \"حليب نيدو 900 جرام\",\n      \"qty\": 1,\n      \"price\": 9800\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/invoices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "invoices"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Invalid Requests (422)",
      "item": [
        {
          "name": "Reject Negative Qty - سارة المقطري",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 422 Unprocessable Entity', function () {",
                  "    pm.response.to.have.status(422);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Validation errors contain items.0.qty', function () {",
                  "    pm.expect(json.errors).to.have.property('items.0.qty');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
