    {
      "name": "4. Read, Search, Pagination & 404",
      "item": [
        {
          "name": "Get Invoice by ID (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Invoice matches saved ID without outer data wrapper', function () {",
                  "    pm.expect(json).to.not.have.property('data');",
                  "    pm.expect(json.id).to.equal(Number(pm.collectionVariables.get('invoice_id')));",
                  "    pm.expect(json.total).to.equal(35650);",
                  "    pm.expect(json.items).to.be.an('array');",
                  "    pm.expect(json.items.length).to.equal(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/invoices/{{invoice_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "invoices",
                "{{invoice_id}}"
              ]
            }
          }
        },
        {
          "name": "Get Non-Existent Invoice (404 No Accept Header)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404 JSON without Accept header', function () {",
                  "    pm.response.to.have.status(404);",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns exact not found message', function () {",
                  "    pm.expect(json.message).to.equal('Invoice not found.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/invoices/99999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "invoices",
                "99999"
              ]
            }
          }
        },
        {
          "name": "Search Invoices by Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Search returns only فاطمة العريقي', function () {",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.data.length).to.equal(1);",
                  "    pm.expect(json.data[0].customer).to.equal('فاطمة العريقي');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/invoices?search=فاطمة",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "invoices"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "فاطمة"
                }
              ]
            }
          }
        },
        {
          "name": "Paginate Invoices",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Pagination metadata and page size are accurate', function () {",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.data.length).to.equal(2);",
                  "    pm.expect(json.meta.per_page).to.equal(2);",
                  "    pm.expect(json.meta.current_page).to.equal(1);",
                  "    pm.expect(json.meta.total).to.be.at.least(4);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/invoices?per_page=2&page=1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "invoices"
              ],
              "query": [
                {
                  "key": "per_page",
                  "value": "2"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
