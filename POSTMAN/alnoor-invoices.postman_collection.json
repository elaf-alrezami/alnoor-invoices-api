{
  "info": {
    "name": "Al-Noor Grocery Invoices API",
    "description": "Ready-to-import Postman Collection (v2.1.0) for Al-Noor Grocery Invoices API. Run sequentially via Postman Collection Runner against a fresh SQLite database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "invoice_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Valid Invoices (201)",
      "item": [
        {
          "name": "Create Invoice - محمد الحميري",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Totals and items match server-side calculation', function () {",
                  "    pm.expect(json.subtotal).to.equal(31000);",
                  "    pm.expect(json.tax).to.equal(4650);",
                  "    pm.expect(json.total).to.equal(35650);",
                  "    pm.expect(json.items).to.be.an('array');",
                  "    pm.expect(json.items.length).to.equal(2);",
                  "});",
                  "",
                  "pm.collectionVariables.set('invoice_id', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "inv-mohammed-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": \"محمد الحميري\",\n  \"items\": [\n    {\n      \"name\": \"رز بسمتي 10 كيلو\",\n      \"qty\": 1,\n      \"price\": 18000\n    },\n    {\n      \"name\": \"سكر 5 كيلو\",\n      \"qty\": 2,\n      \"price\": 6500\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/invoices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "invoices"
              ]
            }
          }
        },
        {
          "name": "Duplicate Retry - محمد الحميري (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK (existing invoice returned)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Returns the exact same invoice ID without creating a duplicate', function () {",
                  "    pm.expect(json.id).to.equal(Number(pm.collectionVariables.get('invoice_id')));",
                  "    pm.expect(json.total).to.equal(35650);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "inv-mohammed-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer\": \"محمد الحميري\",\n  \"items\": [\n    {\n      \"name\": \"رز بسمتي 10 كيلو\",\n      \"qty\": 1,\n      \"price\": 18000\n    },\n    {\n      \"name\": \"سكر 5 كيلو\",\n      \"qty\": 2,\n      \"price\": 6500\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/invoices",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "invoices"
              ]
            }
          }
        },
